<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Ikigai" : "Ikigai" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <% if user_signed_in? %>
      <header class="dhh-header">
        <div class="dhh-page" style="padding-top: 1rem; padding-bottom: 1rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;">
          <div class="dhh-brand">Ikigai</div>
          <nav class="dhh-nav" style="display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center;">
            <%= link_to "Home", root_path, class: nav_link_class(current_page?(root_path)) %>
            <%= link_to "Prospecting", prospecting_path, class: nav_link_class(current_page?(prospecting_path)) %>
            <%= link_to "Contacts", contacts_path, class: nav_link_class(request.path.start_with?("/contacts")) %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete %>
          </nav>
        </div>
      </header>
    <% end %>

    <main class="dhh-page" style="padding-top: 2rem;">
      <% if notice.present? %>
        <p class="dhh-flash dhh-flash-notice"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="dhh-flash dhh-flash-alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
